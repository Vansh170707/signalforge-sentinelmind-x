APP_ENV=development
# Local dev defaults to SQLite (data/sentinelmind.db). Docker Compose overrides this with Postgres.
# DATABASE_URL=postgresql+psycopg://sentinelmind:sentinelmind@db:5432/sentinelmind

# Paid decision engine (TypeSafe Jev) - optional; the app works without it
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BENCHMARK_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=8
JEV_MAX_CONCURRENCY=12
JEV_TOP_N=25

# Free narrative providers - optional; synthetic demo data only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_HARD_MODEL=openai/gpt-oss-120b

# Inception Labs Mercury (diffusion LLM) - fastest valid briefs; free tier 1M input tokens/min
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2.5
INCEPTION_REASONING_EFFORT=instant

# Routing
# mercury = INCEPTION_MODEL (primary), groq_hard = GROQ_HARD_MODEL (gpt-oss-120b), gemini = GEMINI_MODEL then GEMINI_FALLBACK_MODELS,
# groq = GROQ_FAST_MODEL (gpt-oss-20b). A failing provider is skipped for PROVIDER_COOLDOWN_SECONDS.
NARRATIVE_PROVIDER_ORDER=mercury,groq_hard,gemini,groq,template
PREWARM_TOP_N=3
MODEL_CACHE_ENABLED=true

# Optional Microsoft enhancement (Foundry / Azure OpenAI v1-compatible endpoint)
# e.g. FOUNDRY_PROJECT_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=

# Pipeline
CORRELATION_WINDOW_MINUTES=30
CORRELATION_EDGE_THRESHOLD=0.40
RISK_CONFIG_VERSION=v2-jev
PROMPT_VERSION=v2
DEMO_MODE=true
DEMO_SEED=7
